# Campus Connect — environment configuration (Node.js edition)
# Copy this file to .env and adjust values as needed.

# --- Core ---
PORT=3000
SESSION_SECRET=dev-secret-key-change-in-production
NODE_ENV=development

# --- Database ---
# DEMO_MODE=true uses a local SQLite file at ./data/campus_connect.sqlite — zero setup.
# Set DB_DIALECT=mysql (and fill in the MySQL variables) to use the normalized MySQL schema
# in schema.sql instead — matches the project's full production requirement.
DB_DIALECT=sqlite
DB_STORAGE=./data/campus_connect.sqlite

# MySQL settings (used only when DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_connect
DB_USER=root
DB_PASSWORD=

# --- University verification ---
UNIVERSITY_EMAIL_DOMAIN=cuk.ac.in

# --- Demo mode ---
# When true, OTP codes are returned directly in the API response / shown on screen
# instead of being emailed, so the whole verification flow can be demoed without a
# real mail server.
DEMO_MODE=true
DEMO_OTP_CODE=123456

# --- Uploads ---
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_MB=8
